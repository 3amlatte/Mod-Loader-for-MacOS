<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Kept as MelvorModLoader so existing mod DLLs resolve their API reference. -->
    <AssemblyName>MelvorModLoader</AssemblyName>
    <RootNamespace>MelvorModLoader</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Mod Loader for MacOS</Product>
    <AssemblyTitle>Mod Loader for MacOS</AssemblyTitle>
    <Description>Independent Mod Loader for MacOS for Melvor Idle 2, compatible with the MelvorModLoader public mod API.</Description>
    <Company>Mod Loader for MacOS</Company>
    <Copyright>Copyright (c) 2026 3amlatte. MIT License.</Copyright>
    <Nullable>enable</Nullable>

    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Compile-time references only. Override with -p:GameData=... on other machines. -->
    <GameData Condition="'$(GameData)' == ''">..\..\data_GamesByMalcs.Melvor2_windows_x86_64</GameData>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>$(GameData)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GamesByMalcs.Melvor2">
      <HintPath>$(GameData)\GamesByMalcs.Melvor2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Reflection.Metadata.MetadataUpdater.IsSupported" Value="false" />
    <RuntimeHostConfigurationOption Include="System.Runtime.Serialization.EnableUnsafeBinaryFormatterSerialization" Value="false" />
  </ItemGroup>
</Project>
